APP_NAME=CampaignOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://seudominio.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campaignos_prod
DB_USERNAME=campaignos_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Configurações de Armazenamento Seguro
# Defina o path absoluto do storage de campanha fora do public_html
CAMPAIGN_STORAGE_PATH=/var/www/campaignos_storage
